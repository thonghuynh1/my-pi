{
  "name": "my-pi",
  "version": "1.0.0",
  "description": "Personal Pi package: MCP adapter, engineering-skills helpers, and prompt templates.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "mcp"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "session-cost-report": "node scripts/session-cost-report.mjs",
    "check": "tsc --noEmit",
    "playwright:record": "node scripts/playwright-record.mjs",
    "playwright:record-mcp": "node scripts/playwright-record-mcp.mjs",
    "accordion:install": "npm ci --prefix extensions/accordion/app && npm ci --prefix extensions/accordion/extension",
    "accordion:build": "npm run build --prefix extensions/accordion/app",
    "accordion:update": "npm run accordion:build",
    "accordion:broker": "npm run broker --prefix extensions/accordion/extension"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@narumitw/pi-file-context": "^0.54.2",
    "@ogulcancelik/pi-herdr": "^0.2.5",
    "pi-mcp-adapter": "^2.34.0",
    "playwright-core": "^1.61.0",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./node_modules/pi-mcp-adapter/index.ts",
      "./node_modules/@ogulcancelik/pi-herdr/index.ts",
      "./node_modules/@narumitw/pi-file-context/dist/index.ts",
      "./extensions"
    ],
    "prompts": [
      "./prompts"
    ],
    "settings": "./pi.settings.json"
  }
}
